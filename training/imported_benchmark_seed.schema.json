{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ewm:imported-benchmark-seed",
  "title": "Enterprise World Model Imported Benchmark Seed",
  "type": "object",
  "required": [
    "normalization_version",
    "seed_id",
    "source_dataset",
    "source_task_id",
    "task_text",
    "environment",
    "tool_names",
    "tool_categories",
    "state_hooks",
    "candidate_agents",
    "coordination_pattern",
    "conversion_readiness",
    "selection_tags",
    "source_record",
    "notes"
  ],
  "properties": {
    "normalization_version": {
      "type": "string"
    },
    "seed_id": {
      "type": "string"
    },
    "source_dataset": {
      "type": "string"
    },
    "source_task_id": {
      "type": "string"
    },
    "task_text": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "required": [
        "benchmark_family",
        "domain",
        "surfaces"
      ],
      "properties": {
        "benchmark_family": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "tool_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "state_hooks": {
      "type": "object",
      "required": [
        "identify",
        "artifacts",
        "process",
        "relational",
        "context",
        "temporal"
      ],
      "properties": {
        "identify": {
          "type": "object",
          "required": [
            "candidate_roles",
            "stakeholders",
            "named_entities"
          ],
          "properties": {
            "candidate_roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "stakeholders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "named_entities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "object",
          "required": [
            "read",
            "create",
            "update",
            "deliver",
            "durable_objects"
          ],
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "create": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "update": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deliver": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "durable_objects": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "process": {
          "type": "object",
          "required": [
            "preconditions",
            "transitions",
            "target_states",
            "blocking_conditions"
          ],
          "properties": {
            "preconditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "transitions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "target_states": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocking_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "relational": {
          "type": "object",
          "required": [
            "ownership",
            "permissions",
            "dependencies",
            "approvals"
          ],
          "properties": {
            "ownership": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "permissions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "approvals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "required": [
            "facts",
            "communication_channels",
            "domains"
          ],
          "properties": {
            "facts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "communication_channels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "temporal": {
          "type": "object",
          "required": [
            "absolute_dates",
            "relative_constraints",
            "sla_signals",
            "sequencing_constraints"
          ],
          "properties": {
            "absolute_dates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "relative_constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sla_signals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sequencing_constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "candidate_agents": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "display_name",
          "role",
          "responsibilities"
        ],
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "coordination_pattern": {
      "type": "string"
    },
    "conversion_readiness": {
      "type": "object",
      "required": [
        "status",
        "score",
        "blocking_issues",
        "rationale"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready_for_pilot",
            "needs_agent_lift",
            "needs_state_abstraction",
            "low_signal"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "blocking_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "selection_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_record": {
      "type": "object",
      "required": [
        "source_index"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_path": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "trajectory_file": {
          "type": "string"
        },
        "gym": {
          "type": "string"
        },
        "tool_count_observed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
