# Example environment for opt-in live serving integration tests.
#
# Copy the pieces you need into your shell and edit host, model, Python, and
# Slurm settings for your machine. These tests start real model servers and may
# use GPUs, SSH, Slurm allocations, disk, and network access.

export RIL_RUN_INTEGRATION=1

# Select modes explicitly. Supported values:
# existing, generic_existing, local, ssh, slurm, fleet, multinode_slurm, all
export RIL_INTEGRATION_SERVING_MODES=existing

# Shared defaults used by several modes.
export RIL_INTEGRATION_MODEL=Qwen/Qwen2.5-0.5B-Instruct
export RIL_CHAT_TIMEOUT_SECONDS=120

# Existing OpenAI-compatible endpoint mode.
export RIL_EXISTING_BASE_URL=http://127.0.0.1:8123/v1
# export RIL_EXISTING_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# export RIL_EXISTING_API_KEY=

# Generic CLI env-file handoff against an existing endpoint.
# export RIL_INTEGRATION_SERVING_MODES=generic_existing

# Local vLLM mode.
# export RIL_INTEGRATION_SERVING_MODES=local
# export RIL_LOCAL_VLLM_PYTHON_BIN=~/.qwen-vllm/bin/python
# export RIL_LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# export RIL_LOCAL_TENSOR_PARALLEL_SIZE=1
# export RIL_LOCAL_MAX_MODEL_LEN=2048
# export RIL_LOCAL_GPU_MEMORY_UTILIZATION=0.8
# export RIL_LOCAL_EXTRA_ARGS=''

# Non-Slurm SSH vLLM mode.
# Use a real GPU host here, not an gpu-cluster/slurm-login login node.
# export RIL_INTEGRATION_SERVING_MODES=ssh
# export RIL_SSH_TARGET=gpu-host
# export RIL_SSH_VLLM_PYTHON_BIN=~/.qwen-vllm/bin/python
# export RIL_SSH_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# export RIL_SSH_REMOTE_PORT=18817
# export RIL_SSH_TENSOR_PARALLEL_SIZE=1
# export RIL_SSH_MAX_MODEL_LEN=2048
# export RIL_SSH_EXTRA_ARGS=''

# Slurm vLLM mode.
# export RIL_INTEGRATION_SERVING_MODES=slurm
# export RIL_SLURM_TARGET=gpu-cluster
# export RIL_SLURM_VLLM_PYTHON_BIN=~/.mas-vllm-rocm/bin/python
# export RIL_SLURM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# export RIL_SLURM_PARTITION=batch-1gpu-short
# export RIL_SLURM_WALLTIME=00:30:00
# export RIL_SLURM_NUM_GPUS=1
# export RIL_SLURM_MEMORY=32GB
# export RIL_SLURM_CPUS_PER_TASK=4
# export RIL_SLURM_TARGET_DEVICE=rocm
# export RIL_SLURM_MAX_MODEL_LEN=2048
# export RIL_SLURM_EXTRA_ARGS=''

# Fleet mode reads a normal inference config that starts at least two named
# endpoints, for example actor and critic.
# export RIL_INTEGRATION_SERVING_MODES=fleet
# export RIL_FLEET_CONFIG=/path/to/actor-critic.yaml
# export RIL_FLEET_MIN_ENDPOINTS=2

# Multi-node Slurm mode reads a normal slurm_vllm inference config with
# nodes > 1 and distributed_backend: ray.
# export RIL_INTEGRATION_SERVING_MODES=multinode_slurm
# export RIL_MULTINODE_SLURM_CONFIG=/path/to/big-ray.yaml

# Run from packages/remote-inference-launcher:
# uv run pytest tests/integration/test_live_serving_modes.py -m integration -q
