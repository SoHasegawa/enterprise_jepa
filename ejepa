#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_BIN="$SCRIPT_DIR/.venv/bin/ejepa"
CLI_PYTHON="$SCRIPT_DIR/.venv/bin/python"

if [[ -x "$CLI_BIN" ]]; then
  exec "$CLI_BIN" "$@"
fi

if [[ -x "$CLI_PYTHON" ]]; then
  export PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
  exec "$CLI_PYTHON" -m ejepa_cli.cli "$@"
fi

echo "CLI environment is not ready. Run: uv sync" >&2
exit 1
